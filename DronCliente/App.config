<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="DroneBinding"
						 maxReceivedMessageSize="10485760"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00"
                         transferMode="Streamed" />
			</netTcpBinding>
		</bindings>
		<client>
			<endpoint address="net.tcp://localhost:8733/DroneService/"
					  binding="netTcpBinding"
					  bindingConfiguration="DroneBinding"
					  contract="DronWcfService.IDroneService"
					  name="DroneServiceEndpoint" />
		</client>
	</system.serviceModel>
	<appSettings>
		<add key="W_threshold" value="50.0" />
		<add key="Az_threshold" value="5.0" />
		<add key="AzDeviationPercent" value="25.0" />
	</appSettings>
</configuration>