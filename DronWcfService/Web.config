<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="MeasurementsPath" value="Measurements" />
    <add key="W_threshold" value="50.0" />
    <add key="Az_threshold" value="5.0" />
    <add key="AzDeviationPercent" value="25.0" />
  </appSettings>
  <system.serviceModel>
    <services>
      <service name="DronWcfService.DroneService" behaviorConfiguration="DroneServiceBehavior">
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="DroneBinding" contract="DronWcfService.IDroneService"/>
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8733/DroneService/"/>
          </baseAddresses>
        </host>
      </service>
    </services>
    <bindings>
      <netTcpBinding>
        <binding name="DroneBinding" maxReceivedMessageSize="10485760" receiveTimeout="00:10:00" sendTimeout="00:10:00" transferMode="Streamed"/>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="DroneServiceBehavior">
          <serviceMetadata/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <system.web>
    <compilation debug="true"/>
  </system.web>
</configuration>